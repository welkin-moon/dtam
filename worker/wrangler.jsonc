{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "d1-realtime",
  "main": "src/index.js",
  "compatibility_date": "2026-08-10",
  "workers_dev": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "GameRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-room-sqlite",
      "new_sqlite_classes": ["GameRoom"]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
